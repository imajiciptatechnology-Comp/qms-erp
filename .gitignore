# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local sqlite database
/dev.db
/prisma/dev.db
*.db-journal

# runtime JSON data store (created automatically at runtime)
/.data/*.json

# user-uploaded files
/public/uploads/*
!/public/uploads/.gitkeep

# local AI tool configs/caches (not part of the app)
/.claude
/.gemini
/.impeccable
.mock-auth.ts
.mock-next-cache.js
.mock-next-headers.js

# supabase cli local state
/supabase/.temp

.vercel
.env*
/CREDENTIALS.local.md
