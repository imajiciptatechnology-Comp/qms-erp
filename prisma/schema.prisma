generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------
// CORE QMS MODULES
// ---------------------------------------------------------

model NCR {
  id                String  @id @default(cuid())
  ncNumber          String  @unique
  source            String  @default("System")
  department        String
  process           String
  description       String
  severity          String  @default("Minor")
  detectedBy        String?
  productBatch      String?
  isoClause         String?
  dateRaised        String
  dueDate           String
  status            String
  findingType       String
  ofiStatus         String?
  auditId           String?
  supplierId        String?
  supplierName      String?
  linkedRiskId      String?
  linkedRiskNo      String?
  containmentAction String?
  rcaJson           String?
  actionPlanJson    String?
  verificationJson  String?
  historyJson       String  @default("[]")
}

model Audit {
  id            String         @id @default(cuid())
  auditNo       String         @unique
  department    String
  plannedDate   String
  actualDate    String?
  leadAuditor   String
  leadAuditorId String
  status        String
  auditType     String?
  findingsCount Int            @default(0)
  ofiCount      Int            @default(0)
  findings      AuditFinding[]
}

model AuditFinding {
  id               String  @id @default(cuid())
  auditId          String
  description      String
  requirement      String
  type             String
  status           String
  correctiveAction String?
  audit            Audit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
}

model Document {
  id                   String  @id @default(cuid())
  docNumber            String  @unique
  title                String
  type                 String
  revision             Int
  status               String
  department           String
  lastUpdated          String
  uploaderId           String?
  uploaderName         String?
  fileName             String?
  fileSize             Int?
  changeLog            String?
  nextReviewDate       String?
  parentId             String?
  effectiveDate        String?
  approverName         String?
  approvedDate         String?
  origin               String  @default("Internal")
  retentionPeriod      Int?
  isRestricted         Boolean @default(false)
  rejectionReason      String?
  relatedDocIdsJson    String  @default("[]")
  distributionListJson String  @default("[]")
  acknowledgmentsJson  String  @default("[]")
  historyJson          String  @default("[]")
}

// ---------------------------------------------------------
// TRAINING & HR MODULES
// ---------------------------------------------------------

// ---------------------------------------------------------
// RISK & OBJECTIVES MODULES
// ---------------------------------------------------------

model Risk {
  id                 String  @id @default(cuid())
  riskNo             String  @unique
  title              String
  category           String
  process            String
  department         String
  description        String
  potentialImpact    String
  likelihood         Int
  severity           Int
  riskScore          Int
  riskLevel          String
  treatment          String
  mitigationAction   String?
  opportunity        String?
  picId              String?
  picName            String?
  targetDate         String?
  residualLikelihood Int?
  residualSeverity   Int?
  residualScore      Int?
  status             String
  isoClause          String?
  dateIdentified     String
  lastReviewed       String?
  historyJson        String  @default("[]")
}

model QualityObjective {
  id           String        @id @default(cuid())
  objectiveNo  String        @unique
  title        String
  description  String
  department   String
  isoClause    String
  kpiName      String
  kpiUnit      String
  target       Float
  baseline     Float?
  currentValue Float?
  frequency    String
  picName      String?
  startDate    String
  targetDate   String
  status       String
  actions      String?
  year         Int
  measurements Measurement[]
}

model Measurement {
  id          String           @id @default(cuid())
  objectiveId String
  date        String
  value       Float
  notes       String?
  recordedBy  String
  objective   QualityObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
}

model Training {
  id                String  @id @default(cuid())
  trainingNo        String  @unique
  title             String
  type              String
  category          String
  department        String
  trainer           String
  plannedDate       String
  actualDate        String?
  durationHours     Float?
  status            String
  objectives        String?
  evidenceFileName  String?
  isoClause         String?
  effectivenessJson String?
  passingScore      Int?
  ncReferenceId     String?
  ncReferenceNo     String?
  isMandatory       Boolean @default(false)
  reminderSent      Boolean @default(false)
  creatorId         String
  lastUpdated       String
  participantsJson  String  @default("[]")
}

model CompetencyRequirement {
  id                 String @id @default(cuid())
  department         String
  requiredCategories String
  lastUpdated        String
}

// ---------------------------------------------------------
// CUSTOMER & SUPPLIER MODULES
// ---------------------------------------------------------

model Complaint {
  id                String   @id @default(cuid())
  complaintNo       String   @unique
  source            String
  customerName      String
  customerContact   String?
  productService    String
  complaintDate     String
  description       String
  category          String
  severity          String
  status            String
  immediateResponse String?
  rootCause         String?
  correctiveAction  String?
  preventiveAction  String?
  picName           String?
  targetDate        String?
  actualCloseDate   String?
  customerSatisfied Boolean?
  satisfactionScore Int?
  feedbackNotes     String?
  ncReferenceId     String?
  ncReferenceNo     String?
  slaTargetDays     Int      @default(7)
  createdAt         String
  historyJson       String   @default("[]")
}

model SatisfactionSurvey {
  id            String  @id @default(cuid())
  surveyNo      String  @unique
  title         String
  period        String
  status        String
  createdAt     String
  closedAt      String?
  avgScore      Float?
  responsesJson String  @default("[]")
}

model Supplier {
  id                  String               @id @default(cuid())
  supplierNo          String               @unique
  name                String
  category            String
  address             String?
  contactName         String?
  contactEmail        String?
  contactPhone        String?
  productsSupplied    String
  status              String
  qualificationStatus String
  isCritical          Boolean              @default(false)
  certifications      String?
  ncCount             Int                  @default(0)
  approvedDate        String?
  nextEvaluationDate  String?
  notes               String?
  createdAt           String
  createdBy           String
  evaluations         SupplierEvaluation[]
}

model SupplierEvaluation {
  id             String   @id @default(cuid())
  supplierId     String
  period         String
  evaluatedBy    String
  evaluationDate String
  qualityScore   Float
  deliveryScore  Float
  serviceScore   Float
  priceScore     Float
  totalScore     Float
  grade          String
  notes          String?
  supplier       Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------
// OPERATIONS (PPC, MAINTENANCE, CALIBRATION, WELDING)
// ---------------------------------------------------------

model Equipment {
  id              String              @id @default(cuid())
  equipmentName   String
  serialNumber    String              @unique
  category        String              @default("Measuring")
  location        String
  range           String?
  resolution      String?
  frequencyMonths Int
  lastCalDate     String
  nextCalDate     String
  status          String
  tolerance       String
  picName         String?
  pmFrequencyDays Int?
  pmChecklistJson String              @default("[]")
  records         CalibrationRecord[]
  pmRecords       PMRecord[]
}

model CalibrationRecord {
  id                  String    @id @default(cuid())
  equipmentId         String
  date                String
  certificateNo       String
  performedBy         String
  result              String
  remarks             String?
  attachmentUrl       String?
  masterEquipmentUsed String?
  equipment           Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model PMRecord {
  id          String    @id @default(cuid())
  equipmentId String
  date        String
  conductedBy String
  status      String
  notes       String?
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id             String  @id @default(cuid())
  productName    String
  targetQuantity Int
  actualQuantity Int?
  startDate      String
  endDate        String
  status         String
  operator       String
  machineId      String
  notes          String
  qcRequested    Boolean @default(false)
}

model Shipment {
  id                String         @id @default(cuid())
  customerName      String
  destination       String
  shippingDate      String
  logisticsProvider String
  vehicleNumber     String
  status            String
  proofOfDelivery   String?
  remarks           String
  items             ShipmentItem[]
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  productName String
  quantity    Int
  lotNumber   String
  workOrderId String?
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model Asset {
  id           String              @id @default(cuid())
  assetName    String
  serialNumber String              @unique
  category     String
  location     String
  status       String
  mtbf         Float?
  mttr         Float?
  records      MaintenanceRecord[]
}

model MaintenanceRecord {
  id            String @id @default(cuid())
  assetId       String
  type          String
  date          String
  description   String
  performedBy   String
  status        String
  downtimeHours Float?
  cost          Float?
  asset         Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Welder {
  id          String  @id @default(cuid())
  stampNumber String  @unique
  name        String
  processType String
  position    String
  expiryDate  String
  status      String
  notes       String?
}

model WPS {
  id          String @id
  baseMetal   String
  fillerMetal String
  processType String
  status      String
  issueDate   String
}

// ---------------------------------------------------------
// HSE & MOC MODULES
// ---------------------------------------------------------

model Incident {
  id          String @id @default(cuid())
  date        String
  time        String
  location    String
  type        String
  description String
  severity    String
  status      String
  // Storing actions as a stringified JSON for simplicity if it's dynamic, 
  // or just omitting the detailed actions relation to save schema size for now
  actionsJson String @default("[]")
}

model Patrol {
  id           String  @id @default(cuid())
  date         String
  area         String
  inspector    String
  findings     String
  isCompliance Boolean
}

model Moc {
  id               String  @id @default(cuid())
  title            String
  description      String
  category         String
  requester        String
  department       String
  dateRequested    String
  status           String
  riskLevel        String
  assessment       String?
  mitigation       String?
  verifier         String?
  verificationDate String?
  isEffective      Boolean @default(false)
}

// ---------------------------------------------------------
// DESIGN & DEVELOPMENT MODULES
// ---------------------------------------------------------

model DesignProject {
  id              String         @id @default(cuid())
  projectName     String
  description     String
  picName         String
  department      String
  startDate       String
  expectedEndDate String
  status          String
  planningJson    String         @default("{}")
  inputsJson      String         @default("{}")
  controlsJson    String         @default("{}")
  outputsJson     String         @default("{}")
  tasks           DesignTask[]
  changes         DesignChange[]
}

model DesignTask {
  id         String        @id @default(cuid())
  projectId  String
  title      String
  assignedTo String
  dueDate    String
  status     String
  project    DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DesignChange {
  id               String        @id @default(cuid())
  projectId        String
  date             String
  requester        String
  description      String
  impactAnalysis   String
  documentAction   String?
  targetDocumentId String?
  status           String
  reviewer         String?
  project          DesignProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  passwordHash String
  role         String
  department   String
  photoUrl     String?
  phone        String?
  bio          String?
}

model ApprovalRouting {
  id         String   @id @default(cuid())
  moduleType String
  recordId   String
  stage      Int
  approverId String
  status     String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------
// KEY-VALUE STORE (pengganti .data/*.json agar bisa jalan serverless)
// ---------------------------------------------------------

model KvStore {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// SALES & MARKETING (B2B: penawaran → PO customer → invoice → kontrak)
// Nominal dalam Rupiah. Status "jatuh tempo"/"hampir habis" dihitung dari tanggal, tidak disimpan.
// ---------------------------------------------------------

model Customer {
  id             String        @id @default(cuid())
  customerNo     String        @unique
  name           String
  type           String // Universitas | Rumah Sakit | Farmasi | Lab Pangan | Pemerintah | Industri
  npwp           String?
  address        String?
  city           String?
  contactName    String?
  contactTitle   String?
  contactEmail   String?
  contactPhone   String?
  paymentTerms   String        @default("30 hari")
  status         String        @default("Active")
  notes          String?
  createdAt      String
  historyJson    String        @default("[]")
  opportunities  Opportunity[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       Invoice[]
  contracts      Contract[]
  signatoryName  String?
  signatoryTitle String?
}

model Product {
  id                        String  @id @default(cuid())
  sku                       String  @unique
  name                      String
  category                  String
  brand                     String
  model                     String?
  unit                      String  @default("Unit")
  price                     Float
  availability              String  @default("Ready") // Ready | Indent
  leadTimeWeeks             Int?
  warrantyMonths            Int     @default(12)
  requiresCalibration       Boolean @default(false)
  calibrationIntervalMonths Int?
  description               String?
  specs                     String?
  isActive                  Boolean @default(true)
  createdAt                 String
}

model Opportunity {
  id                String      @id @default(cuid())
  opportunityNo     String      @unique
  title             String
  customerId        String
  stage             String // Lead | Qualified | Quotation | Negotiation | Won | Lost
  source            String // Tender | Referensi | Website | Pameran | Repeat Order
  estimatedValue    Float       @default(0)
  probability       Int         @default(10)
  expectedCloseDate String?
  salesName         String
  lostReason        String?
  notes             String?
  createdAt         String
  historyJson       String      @default("[]")
  customer          Customer    @relation(fields: [customerId], references: [id])
  quotations        Quotation[]
}

model Quotation {
  id              String          @id @default(cuid())
  quotationNo     String
  revision        Int             @default(0)
  customerId      String
  opportunityId   String?
  date            String
  validUntil      String
  status          String // Draft | Waiting Approval | Approved | Sent | Accepted | Rejected | Superseded
  subject         String
  attention       String?
  introText       String?
  closingText     String?
  subtotal        Float           @default(0)
  discountPercent Float           @default(0)
  discountAmount  Float           @default(0)
  taxPercent      Float           @default(11)
  taxAmount       Float           @default(0)
  total           Float           @default(0)
  paymentTerms    String?
  deliveryTerms   String?
  warrantyTerms   String?
  notes           String?
  salesName       String
  approvedBy      String?
  approvedAt      String?
  createdBy       String
  createdAt       String
  historyJson     String          @default("[]")
  customer        Customer        @relation(fields: [customerId], references: [id])
  opportunity     Opportunity?    @relation(fields: [opportunityId], references: [id])
  items           QuotationItem[]
  salesOrders     SalesOrder[]

  @@unique([quotationNo, revision])
}

model QuotationItem {
  id              String    @id @default(cuid())
  quotationId     String
  productId       String?
  description     String
  specs           String?
  qty             Float
  unit            String
  unitPrice       Float
  discountPercent Float     @default(0)
  lineTotal       Float
  sortOrder       Int       @default(0)
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model SalesOrder {
  id                  String           @id @default(cuid())
  soNo                String           @unique
  customerId          String
  quotationId         String?
  customerPoNo        String
  customerPoDate      String
  customerPoFile      String?
  orderDate           String
  status              String // Contract Review | Confirmed | In Delivery | Installed | Completed | Cancelled
  contractReviewJson  String           @default("[]")
  deliveryAddress     String?
  expectedDelivery    String?
  shipmentId          String?
  installationDate    String?
  bastNo              String?
  bastDate            String?
  subtotal            Float            @default(0)
  taxAmount           Float            @default(0)
  total               Float            @default(0)
  paymentScheduleJson String           @default("[]")
  salesName           String
  notes               String?
  createdAt           String
  historyJson         String           @default("[]")
  customer            Customer         @relation(fields: [customerId], references: [id])
  quotation           Quotation?       @relation(fields: [quotationId], references: [id])
  items               SalesOrderItem[]
  invoices            Invoice[]
  contracts           Contract[]
}

model SalesOrderItem {
  id            String     @id @default(cuid())
  salesOrderId  String
  productId     String?
  description   String
  qty           Float
  unit          String
  unitPrice     Float
  lineTotal     Float
  serialNumbers String?
  sortOrder     Int        @default(0)
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String            @id @default(cuid())
  invoiceNo     String            @unique
  customerId    String
  salesOrderId  String?
  termLabel     String
  termPercent   Float?
  invoiceDate   String
  dueDate       String
  subtotal      Float
  taxAmount     Float
  total         Float
  paidAmount    Float             @default(0)
  status        String // Unpaid | Partial | Paid | Cancelled
  fakturPajakNo String?
  notes         String?
  createdAt     String
  historyJson   String            @default("[]")
  customer      Customer          @relation(fields: [customerId], references: [id])
  salesOrder    SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  payments      Payment[]
  contractId    String?
  contract      Contract?         @relation(fields: [contractId], references: [id])
  periodLabel   String?
  items         InvoiceItem[]
  reminders     PaymentReminder[]
}

/// Rincian invoice manual / dari kontrak (invoice per termin SO tidak memakai tabel ini).
model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  qty         Float
  unit        String
  unitPrice   Float
  lineTotal   Float
  sortOrder   Int     @default(0)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

/// Surat pengingat pembayaran (disusun AI, disimpan agar bisa dicetak ulang & diaudit).
model PaymentReminder {
  id        String  @id @default(cuid())
  letterNo  String  @unique
  invoiceId String
  level     Int // 1 = pengingat, 2 = peringatan, 3 = peringatan terakhir
  date      String
  subject   String
  body      String
  createdBy String
  createdAt String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id          String  @id @default(cuid())
  invoiceId   String
  paymentDate String
  amount      Float
  method      String // Transfer | Giro | Tunai
  reference   String?
  proofUrl    String?
  receivedBy  String
  createdAt   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  receiptNo   String?
}

model Contract {
  id                String      @id @default(cuid())
  contractNo        String      @unique
  customerId        String
  salesOrderId      String?
  type              String // Garansi | Service | Kalibrasi | AMC
  title             String
  startDate         String
  endDate           String
  value             Float       @default(0)
  visitsPerYear     Int?
  coveredItemsJson  String      @default("[]")
  status            String // Active | Expired | Terminated | Renewed
  picName           String?
  notes             String?
  createdAt         String
  historyJson       String      @default("[]")
  customer          Customer    @relation(fields: [customerId], references: [id])
  salesOrder        SalesOrder? @relation(fields: [salesOrderId], references: [id])
  invoices          Invoice[]
  // Dokumen perjanjian (AMC/Kalibrasi/Service). Status lengkap: Draft | Waiting Approval | Approved | Sent | Active | Expired | Terminated | Renewed
  scope             String?
  responseTime      String?
  paymentTerms      String?
  billingSchedule   String      @default("Upfront") // Upfront | Quarterly
  sparePartDiscount Float?
  signatoryName     String?
  signatoryTitle    String?
  clausesJson       String      @default("[]")
  approvalDueDate   String?
  approvedBy        String?
  approvedAt        String?
  signedFileUrl     String?
  renewedFromId     String?
}
